#!/usr/bin/env bash
set -e

echo "-----> [post_compile] Forzando opencv-python-headless (sin libGL)"

# Eliminar cualquier versión con GUI que ultralytics haya jalado
pip uninstall -y opencv-python opencv-contrib-python 2>/dev/null || true

# Instalar la versión headless (no requiere libGL.so.1)
pip install --no-cache-dir opencv-python-headless

# Verificar que cv2 importa correctamente — falla el build si no
python -c "import cv2; print('[post_compile] cv2 OK, version:', cv2.__version__)"

echo "-----> [post_compile] Listo"
